# ---------------------------------------------------------------------------
# Paalan environment variables
#
# You do NOT need any of these to try the prototype: with no .env at all, the
# app runs in zero-config demo mode using built-in sample data.
#
# To use a real database, copy this file to `.env`, fill in DATABASE_URL, then
# run `bun run db:setup` (migrate + seed) before `bun run dev`.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, or any Postgres provider).
# Leave unset to run in demo mode.
DATABASE_URL=

# Auth.js secret — only needed once magic-link auth is wired up (not in v1 yet).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
